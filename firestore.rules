rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /gallery_replacements/{replacementId} {
      allow read: if true;
      // Allow writes to gallery_replacements with valid ID
      allow create, update, delete: if isValidId(replacementId);
    }

    match /user_favorites/{favoriteId} {
      allow read: if true;
      // Allow users to store and manage their favorited creations
      allow create, update, delete: if isValidId(favoriteId);
    }
  }
}
