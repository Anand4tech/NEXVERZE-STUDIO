rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    match /gallery_replacements/{replacementId} {
      allow read: if true;
      // Allow unauthenticated writes to gallery_replacements to unblock creator
      allow create, update, delete: if isValidId(replacementId);
    }
  }
}
